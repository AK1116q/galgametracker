{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route pack v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "synthetic",
    "status",
    "game",
    "release",
    "sources",
    "routes",
    "choices",
    "endings",
    "reviews"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "enum": ["draft", "in_review", "verified", "withdrawn", "source_checked"]
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "aliases"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "$ref": "#/definitions/text"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "locale"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/text"
        },
        "locale": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/route"
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/choice"
      }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ending"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/review"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/text"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reference", "permission"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": [
            "synthetic",
            "own_notes",
            "authorized_guide",
            "public_reference"
          ]
        },
        "reference": {
          "$ref": "#/definitions/text"
        },
        "permission": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "safeLabel", "entryChoiceId", "requiredEndingIds"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "safeLabel": {
          "$ref": "#/definitions/text"
        },
        "entryChoiceId": {
          "$ref": "#/definitions/id"
        },
        "requiredEndingIds": {
          "$ref": "#/definitions/ids"
        }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "safeLabel", "hiddenTitle", "spoilerLevel"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "safeLabel": {
          "$ref": "#/definitions/text"
        },
        "hiddenTitle": {
          "$ref": "#/definitions/text"
        },
        "spoilerLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["choice", "ending", "unknown"]
        },
        "id": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "next"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "next": {
          "$ref": "#/definitions/destination"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["choiceId", "optionId"],
          "properties": {
            "choiceId": {
              "$ref": "#/definitions/id"
            },
            "optionId": {
              "$ref": "#/definitions/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["endingId"],
          "properties": {
            "endingId": {
              "$ref": "#/definitions/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag", "equals"],
          "properties": {
            "flag": {
              "$ref": "#/definitions/id"
            },
            "equals": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["counter", "atLeast"],
          "properties": {
            "counter": {
              "$ref": "#/definitions/id"
            },
            "atLeast": {
              "type": "number"
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "when",
        "recommendedOptionIds",
        "sourceId",
        "sourceLocator"
      ],
      "properties": {
        "routeId": {
          "$ref": "#/definitions/id"
        },
        "when": {
          "$ref": "#/definitions/condition"
        },
        "recommendedOptionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "sourceId": {
          "$ref": "#/definitions/id"
        },
        "sourceLocator": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "prompt", "options", "rules"],
      "properties": {
        "kind": { "enum": ["choice", "instruction"] },
        "orderKnown": { "type": "boolean" },
        "optionsComplete": { "type": "boolean" },
        "id": {
          "$ref": "#/definitions/id"
        },
        "locator": {
          "$ref": "#/definitions/text"
        },
        "prompt": {
          "$ref": "#/definitions/text"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/option"
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "skipTo": {
          "$ref": "#/definitions/destination"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "instruction" } }
          },
          "then": {
            "properties": { "options": { "type": "array", "maxItems": 1 } }
          },
          "else": {
            "if": {
              "required": ["optionsComplete"],
              "properties": { "optionsComplete": { "const": false } }
            },
            "then": {},
            "else": {
              "properties": { "options": { "type": "array", "minItems": 2 } }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "date", "routeIds", "evidence"],
      "properties": {
        "reviewer": {
          "$ref": "#/definitions/text"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "routeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "evidence": {
          "$ref": "#/definitions/text"
        },
        "method": {
          "enum": ["source_crosscheck", "playtest"]
        }
      }
    }
  }
}
