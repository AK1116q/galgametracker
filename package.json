{
  "name": "galgametracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:data && npm test && npm run build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "deploy": "npm run check && wrangler pages deploy dist --project-name=galgametracker"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.17.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
